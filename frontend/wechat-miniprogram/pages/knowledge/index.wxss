.filter-row {
  display: flex;
  gap: 9px;
  margin: 10px 0;
}

.filter-cell {
  flex: 1;
  min-width: 0;
}

.filter-cell .picker-value {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13px;
}

.library-entry {
  padding: 21px 0;
  border-bottom: 1px solid #dfe6dc;
}

.entry-title {
  justify-content: space-between;
  text-align: left;
  padding: 13px 0 9px;
  gap: 15px;
  font-size: 18px;
}

.entry-title text {
  flex: none;
  color: #5b6e63;
}

.entry-body {
  margin: 16px 0;
}

.experience-form {
  margin-top: 20px;
}

.experience-form .textarea {
  min-height: 100px;
  height: 115px;
}

.mine-active {
  background: #dfeadd;
}

.example-list { margin: 22px 0 8px; }
.example-card { padding: 20px; margin: 14px 0; background: #f0f3eb; border-radius: 18px; }
.example-author { display: flex; gap: 11px; align-items: center; }
.example-avatar { display: flex; width: 38px; height: 38px; border-radius: 50%; background: #d6e4d6; align-items: center; justify-content: center; color: #245448; font-weight: 600; }
.example-byline { flex: 1; }
.example-name { display: block; font-size: 14px; font-weight: 600; }
.example-meta { display: block; font-size: 12px; margin-top: 3px; }
.example-preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.65; }

.entry-body {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.collection-pagination,
.content-pagination {
  margin-top: 18px;
}

.pagination-actions {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.pagination-actions>view {
  flex: 1;
  min-width: 0;
}

.pagination-actions button {
  min-height: 46px;
  font-size: 13px;
  padding: 10px 8px;
}
