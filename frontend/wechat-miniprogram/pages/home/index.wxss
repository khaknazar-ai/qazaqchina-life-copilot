.home-progress {
  display: block;
  margin-top: 15px;
}

.home-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.wordmark {
  font-size: 21px;
  font-weight: 650;
  letter-spacing: -.6px;
}

.brand-dot {
  color: #368772;
}

.language-control {
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: 13px;
  color: #5b6e63;
}

.home-hero {
  margin: 30px 0 25px;
}

.home-hero .title {
  max-width: 310px;
  font-size: 34px;
}

.home-hero .subtitle {
  margin-top: 10px;
  font-size: 14px;
}

.home-compose {
  padding: 18px;
  background: #fff;
  border: 1px solid #dce5d9;
  border-radius: 22px;
  box-shadow: 0 7px 24px rgba(24, 61, 40, .035);
}

.home-input {
  width: 100%;
  min-height: 96px;
  max-height: 200px;
  font-size: 17px;
  line-height: 1.5;
  color: #203531;
}

.input-tools {
  display: flex;
  gap: 10px;
  margin: 10px 0 15px;
}

.tool-wrap {
  flex: 0 0 94px;
}

.wide-tool {
  flex: 1;
}

.attach-button {
  min-height: 44px;
  justify-content: flex-start;
  padding: 8px 10px;
  border-radius: 10px;
  background: #f2f5ee;
  color: #486959;
  font-size: 13px;
  gap: 6px;
}

.attach-button image {
  width: 22px;
  height: 22px;
}

.button-arrow {
  margin-left: auto;
  font-size: 20px;
}

.home-compose .primary-button {
  justify-content: space-between;
}

.kazakhstan-trip-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 12px 0 22px;
  padding: 15px 17px;
  border: 1px solid #dce5d9;
  border-radius: 16px;
  background: #f4f7f1;
  color: #203531;
  text-align: left;
}

.kazakhstan-trip-title,
.kazakhstan-trip-hint {
  display: block;
}

.kazakhstan-trip-title {
  font-size: 15px;
  font-weight: 650;
}

.kazakhstan-trip-hint {
  margin-top: 4px;
  color: #5b6e63;
  font-size: 12px;
}

.kazakhstan-trip-arrow {
  color: #177668;
  font-size: 22px;
}

.recent-case {
  background: #eaf0e6;
  border-radius: 17px;
  padding: 18px;
}

.recent-title {
  display: block;
  font-size: 18px;
  font-weight: 600;
  margin: 12px 0 9px;
}

.home-empty {
  padding: 7px 0 13px;
}

.emergency-link {
  justify-content: space-between;
  padding: 18px 0;
  text-align: left;
  border-top: 1px solid #dce3d9;
  border-radius: 0;
  color: #975a3d;
  font-weight: 500;
}

.emergency-title {
  display: block;
  margin-bottom: 3px;
  font-size: 15px;
}

@media(max-width:360px) {
  .home-hero .title {
    font-size: 31px;
  }
  .home-compose {
    padding: 15px;
  }
}
