page {
  min-height: 100%;
  background: #f7f6f2;
  color: #203531;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.55;
}

view,
form,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

form {
  display: block;
  width: 100%;
}

text {
  overflow-wrap: anywhere;
}

button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 46px;
  height: auto;
  margin: 0 0 12px;
  padding: 12px 18px;
  border: 0;
  border-radius: 14px;
  background: transparent;
  color: #203531;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.45;
  white-space: normal;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: .48;
}

button text {
  pointer-events: none;
}

.page {
  padding: 24px 22px 40px;
}

.page-heading {
  margin-bottom: 25px;
}

.eyebrow {
  display: block;
  margin-bottom: 10px;
  color: #5b6e63;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1.5px;
}

.title {
  display: block;
  color: #203531;
  font-size: 30px;
  line-height: 1.2;
  font-weight: 650;
  letter-spacing: -.7px;
}

.subtitle {
  display: block;
  margin-top: 12px;
  color: #63756e;
  font-size: 15px;
  line-height: 1.55;
}

.card {
  margin-bottom: 18px;
  padding: 20px;
  background: #fff;
  border: 1px solid #e8ece7;
  border-radius: 20px;
}

.card-title,
.section-title {
  display: block;
  margin-bottom: 8px;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.4;
}

.section-title {
  margin-top: 22px;
}

.body-text {
  display: block;
  font-size: 15px;
  line-height: 1.65;
  white-space: pre-wrap;
}

.muted,
.hint {
  display: block;
  color: #5b6e63;
  font-size: 13px;
  line-height: 1.55;
}

.field-label {
  display: block;
  margin: 16px 0 7px;
  color: #465d54;
  font-size: 13px;
  font-weight: 600;
}

.field-label:first-child {
  margin-top: 0;
}

.input,
.textarea,
.picker-value {
  display: block;
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #dae3dc;
  border-radius: 12px;
  background: #fafbf8;
  color: #203531;
  font-size: 15px;
  line-height: 1.55;
}

.input {
  min-height: 46px;
  height: 46px;
}

.textarea {
  min-height: 142px;
  height: 160px;
}

.picker-value {
  min-height: 46px;
}

.primary-button {
  background: #176f61;
  color: #fff;
}

.secondary-button {
  background: #eaf1eb;
  color: #235c50;
}

.warning-button {
  background: #f5e9df;
  color: #8d482d;
}

.text-button {
  color: #236d5e;
  font-size: 14px;
  padding: 10px 0;
}

.button-pressed {
  opacity: .7;
}

.notice {
  display: block;
  margin: 12px 0;
  padding: 14px 16px;
  border-radius: 12px;
  background: #edf2ec;
  color: #4f655a;
  font-size: 13px;
  line-height: 1.6;
}

.notice text+text {
  margin-top: 7px;
}

.status-error {
  display: block;
  margin: 10px 0;
  color: #a24036;
  font-size: 14px;
}

.status-warning {
  display: block;
  margin: 8px 0;
  color: #8b5c33;
  font-size: 13px;
  line-height: 1.6;
}

.status-success {
  display: block;
  color: #236d5e;
  font-size: 14px;
}

.warning-panel,
.danger-panel {
  background: #f7eee4;
}

.tag-row,
.inline-actions,
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag,
.severity-badge {
  display: inline-block;
  padding: 4px 9px;
  border-radius: 7px;
  background: #eaf1eb;
  color: #476858;
  font-size: 12px;
  line-height: 1.45;
}

.tag-risk,
.severity-badge-high {
  background: #f6e7dc;
  color: #8c472f;
}

.inline-actions {
  margin-top: 12px;
  align-items: center;
}

.inline-actions>view {
  flex: 1;
  min-width: 0;
}

.inline-actions button {
  margin: 0;
}

.row,
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.section-heading {
  margin: 24px 0 10px;
}

.section-heading .section-title {
  margin: 0;
}

.section-heading button {
  margin: 0;
}

.row-copy {
  flex: 1;
  min-width: 0;
}

.list-item,
.source-note,
.fact-item {
  padding: 15px 0;
  border-bottom: 1px solid #e8ece6;
}

.list-item:last-child {
  border-bottom: 0;
}

.empty {
  padding: 25px 0;
}

.segmented {
  display: flex;
  gap: 4px;
  padding: 4px;
  border-radius: 13px;
  background: #eaece5;
  margin: 16px 0;
}

.segment {
  flex: 1;
  min-width: 0;
}

.segment button {
  min-height: 44px;
  padding: 9px 7px;
  margin: 0;
  font-size: 13px;
  color: #5b6e63;
  border-radius: 10px;
}

.segment .selected {
  color: #1f6758;
  background: #fff;
}

.disclosure-button {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  color: #356254;
  font-size: 14px;
  text-align: left;
}

.source-url {
  display: block;
  word-break: break-all;
  color: #286954;
  font-size: 13px;
}

.step-item,
.checklist-item {
  display: flex;
  gap: 13px;
  padding: 12px 0;
}

.step-number {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #e9f0e8;
  color: #2b6e58;
  font-size: 13px;
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-content .card-title {
  font-size: 15px;
}

.divider {
  height: 1px;
  margin: 22px 0;
  background: #e3e8e0;
}

.consent {
  display: flex;
  gap: 9px;
  align-items: flex-start;
  margin: 15px 0;
  font-size: 13px;
  color: #526b5d;
  line-height: 1.55;
}

.consent checkbox {
  flex-shrink: 0;
}

.phrase-card {
  padding: 26px 22px;
  margin: 20px 0;
  border: 1px solid #c7dbce;
  border-radius: 20px;
  background: #fff;
}

.phrase-zh {
  display: block;
  font-size: 26px;
  line-height: 1.7;
  letter-spacing: 1px;
}

.sheet {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 24px;
  background: rgba(21, 42, 35, .65);
}

.sheet-content {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 26px 22px;
  background: #f7f6f2;
  border-radius: 24px;
}

.pill {
  border-radius: 24px;
  background: #fff;
  border: 1px solid #dbe6dc;
  min-height: 44px;
  padding: 9px 14px;
  font-size: 13px;
}

.source-id {
  display: block;
  color: #5b6e63;
  font-size: 12px;
}

.trace-row {
  margin: 10px 0;
}

.photo-preview {
  display: block;
  width: 100%;
  max-height: 260px;
  border-radius: 14px;
  margin: 16px 0;
}

.loading-line {
  display: block;
  margin: 20px 0;
  color: #5b6e63;
  font-size: 14px;
}

@media (max-width:360px) {
  .page {
    padding-left: 18px;
    padding-right: 18px;
  }
  .card {
    padding: 17px;
  }
  .title {
    font-size: 28px;
  }
}
