APP_ENV=development
LOG_LEVEL=INFO
# MockLLM is the safe default. External providers are manual-only.
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-qazaqchina-local
LLM_ENABLE_EXTERNAL=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Supported provider choices: mock, openai, deepseek, openrouter.
# Configure real providers through environment variables. See README.md for local launch.
# Never commit API keys.
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LOCAL_DATA_DIR=data/local
ENABLE_LOCAL_PERSISTENCE=false
# Local/internal demo only; production and staging startup remain blocked.
# Persistence stores local cases, moderated posts, review audit, source candidates/versions,
# redacted session memory, support queues and privacy requests beneath LOCAL_DATA_DIR.
ADMIN_AUTH_ENABLED=false
# Supply a random ASCII token (32+ characters) using the environment or secret manager.
# Never save the real token in this example. A comma-separated role list is supported.
ADMIN_AUTH_TOKEN=
ADMIN_AUTH_ACTOR_ID=local-operator
ADMIN_AUTH_ROLES=admin_viewer
# Optional independent approver. Set real tokens only in process environment variables.
ADMIN_REVIEW_AUTH_TOKEN=
ADMIN_REVIEW_AUTH_ACTOR_ID=
ADMIN_REVIEW_AUTH_ROLES=source_publisher
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
USE_AGENT_WORKFLOW=false
AGENT_USE_LANGGRAPH=false
AGENT_LANGGRAPH_USE_HYBRID_RAG=true

# Alibaba Cloud: set real credentials only in environment variables or a secret manager.
QWEN_CHAT_ENABLED=false
QWEN_OCR_ENABLED=false
CLOUD_RETRIEVAL_ENABLED=false
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_RERANK_ENABLED=false
QWEN_RERANK_MODEL=qwen3-rerank
SEMANTIC_CONFLICT_REVIEW_ENABLED=false
DASHSCOPE_API_KEY=
# Copy your workspace API Host and append /compatible-mode/v1. No region is assumed.
DASHSCOPE_BASE_URL=
QWEN_CHAT_MODEL=qwen3.7-plus
# Singapore OCR default; qwen3.5-ocr currently requires Beijing.
QWEN_OCR_MODEL=qwen-vl-ocr-2025-11-20
QWEN_TIMEOUT_SECONDS=30
QWEN_CHAT_MAX_TOKENS=1200
QWEN_OCR_MAX_TOKENS=4096
# Combined chat, OCR, embedding and reranking attempt limits; not a currency budget.
QWEN_DAILY_REQUEST_LIMIT=20
QWEN_REQUESTS_PER_MINUTE=6
# Required for cloud mode: JSON participant-ID -> unique random access-token mapping.
# Supply only through the process environment / secret manager, never in this file.
PILOT_ACCESS_TOKENS=
# Trusted participant-ID -> citizen/consul assignment; defaults to citizen.
PILOT_ACCOUNT_TYPES={}
# Local launcher only. Keep disabled in any shared deployment.
LOCAL_DEVICE_SIGNIN_ENABLED=false
LOCAL_DEVICE_SIGNIN_DEVTOOLS_REFERER=
API_MAX_BODY_BYTES=65536
API_MAX_IMAGE_BODY_BYTES=6800000
API_MAX_CONCURRENT_REQUESTS=8
API_BODY_TIMEOUT_SECONDS=10
API_USER_REQUESTS_PER_MINUTE=20
API_IP_REQUESTS_PER_MINUTE=120
